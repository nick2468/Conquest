# Installed packages. Never commit these. They are re-downloaded by "npm install".
node_modules/

# Build output.
dist/
build/
.vite/
# The service worker built for development. devOptions is off, so this
# should never appear, but it costs nothing to keep it out of the repo.
dev-dist/

# Editor settings. Two files ARE committed, so that anyone opening the folder
# gets the same extensions and the same formatting.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Operating system junk.
.DS_Store
Thumbs.db

# Logs.
*.log
npm-debug.log*

# Local settings that only apply to one machine.
.env
.env.local

# The engine built for the tuner's workers, and what the tuner found.
# Both are made by "npm run tune". See tools/tune.mjs.
tools/dist/
tools/tune-report.txt
tools/league-report.txt

# Wrangler keeps its local server state here. Not ours to commit.
.wrangler/
public/scratch/
