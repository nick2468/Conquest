# Installed packages. Never commit these. They are re-downloaded by "npm install".
node_modules/

# Build output.
dist/
build/
.vite/

# Editor settings. Two files ARE committed, so that anyone opening the folder
# gets the same extensions and the same formatting.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Operating system junk.
.DS_Store
Thumbs.db

# Logs.
*.log
npm-debug.log*

# Local settings that only apply to one machine.
.env
.env.local
