{
  "name": "conquest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A turn-based territory game set in Australia.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5181 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "icons": "node tools/make-icons.mjs",
    "tune:build": "vite build --config tools/engine.config.mjs",
    "tune": "node tools/tune.mjs",
    "league": "node tools/league.mjs",
    "server": "wrangler dev",
    "server:deploy": "wrangler deploy"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^24.13.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "4.1.11",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.86.0"
  }
}
